# Copy to .env.local for local work. On Vercel add these under
# Project → Settings → Environment Variables.

# Neon (or any Postgres) connection string
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Long random string. Signs sessions and member QR codes. Never share it.
BETTER_AUTH_SECRET=

# Public address of the site, no trailing slash (QPay calls back here)
PUBLIC_URL=https://sparta-fitness.vercel.app

# Phones that become admin on first login, comma separated
ADMIN_PHONES=99112233

# ── SMS (OTP) ────────────────────────────────────────────────
# Leave SMS_PROVIDER empty for test mode: codes are printed to the server log.
# In production test mode is refused unless ALLOW_TEST_SMS=1.
SMS_PROVIDER=
CALLPRO_API_KEY=
CALLPRO_SENDER=
# Check this against CallPro's docs when you get the key
CALLPRO_API_URL=https://api.messagepro.mn/send
ALLOW_TEST_SMS=

# ── QPay ─────────────────────────────────────────────────────
# empty = mock (fake QR + test button), sandbox = QPay test server, live = real money
QPAY_MODE=
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
# Allows the "Тест: төлсөн болгох" button on a deployed site while QPAY_MODE is empty
ALLOW_MOCK_PAY=
